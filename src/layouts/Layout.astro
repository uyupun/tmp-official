    <meta name="description" content="(´･ェ･｀)「あ、もしもし？ぅゅだけど…うん、そうぷんぽぷんぽ」">
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" as="image" href="/uyupun_logo.png" fetchpriority="high" />
    <Font cssVariable="--font-pirata-one" preload />
    <Font cssVariable="--font-zen-kaku-gothic-new" />
    <meta name="generator" content={Astro.generator} />
    <title>UYUPUN</title>
  </head>
  <body>
    <IridescentBackground />
    <slot />
  </body>
</html>
