---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import IridescentBackground from "../components/IridescentBackground.astro";

export interface Props {
  title?: string;
  // ロゴを最初に描くページだけ true にする。ロゴのないページで先読みすると、使わない画像を読み込んでしまう
  preloadLogo?: boolean;
}

const { title = "UYUPUN", preloadLogo = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="(´･ェ･｀)「あ、もしもし？ぅゅだけど…うん、そうぷんぽぷんぽ」">
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    {preloadLogo && <link rel="preload" as="image" href="/uyupun_logo.png" fetchpriority="high" />}
    <Font cssVariable="--font-pirata-one" preload />
    <Font cssVariable="--font-zen-kaku-gothic-new" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {/* ページ遷移で背景の WebGL を作り直さず、渦を途切れさせないため */}
    <ClientRouter />
  </head>
  <body>
    <IridescentBackground />
    <slot />
  </body>
</html>
