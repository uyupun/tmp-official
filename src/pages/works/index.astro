---
// 作品の一覧。トップの各セクションと同じ最大幅の中に、並び順どおり並べる
// トップはタブレット幅で細くなるが、ここは2列にするので細くしない
import HomeLink from "../../components/HomeLink.astro";
import WorkCard from "../../components/WorkCard.astro";
import Layout from "../../layouts/Layout.astro";
import { getWorks, ratioOf, type Work } from "../../lib/works";

const works = await getWorks();

// 2列の石積み。並び順に1件ずつ、その時点で短いほうの列へ入れる（左右の下端がおおよそそろい、上にあるものほど先になる）
// カードの高さは列の幅を1とした相対値で見積もる。画像は 1 / 縦横比、作品名と種別の行はおよそ 0.2
const CAPTION_HEIGHT = 0.2;
const columns: Work[][] = [[], []];
const heights = [0, 0];
for (const work of works) {
  const shorter = heights[0] <= heights[1] ? 0 : 1;
  columns[shorter].push(work);
  heights[shorter] += 1 / ratioOf(work) + CAPTION_HEIGHT;
}
---

<Layout title="WORKS | UYUPUN">
  <div class="flex flex-col items-center min-h-screen px-4 py-8 md:px-8">
    <HomeLink />
    <section class="mt-8 w-full max-w-2xl">
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-center mb-8 display-text">WORKS</h1>
      {/* スマホは1列（2列だと横長の画像が小さくなりすぎる）。列ごとに振り分けた DOM では順番が崩れるので別に組む */}
      <div class="flex flex-col gap-2 md:hidden">
        {works.map((work) => <WorkCard work={work} />)}
      </div>
      <div class="hidden md:grid grid-cols-2 items-start gap-2">
        {columns.map((column) => (
          <div class="flex flex-col gap-2">
            {column.map((work) => <WorkCard work={work} />)}
          </div>
        ))}
      </div>
    </section>
    <HomeLink class="mt-8 mb-16" />
  </div>
</Layout>
