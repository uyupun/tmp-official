---
// メンバーカードコンポーネント
import NewTabMark from "./NewTabMark.astro";

export interface Props {
  name: string;
  roles: string[];
  imageUrl?: string;
  websiteUrl?: string;
}

const { name, roles, imageUrl, websiteUrl } = Astro.props;

// リンクありのカードは全体をリンクにする（押せる範囲を広げるため）
const Tag = websiteUrl ? "a" : "div";
const linkProps = websiteUrl
  ? { href: websiteUrl, target: "_blank", rel: "noopener noreferrer" }
  : {};
---

<Tag
  {...linkProps}
  class:list={[
    "relative block bg-black/50 backdrop-blur-sm rounded-lg p-7 text-white",
    websiteUrl && "hover:bg-black/65 focus-visible:bg-black/65 transition-colors",
  ]}
>
  {/* リンクのないカードと見分けるための目印（スマホでも見えるよう常に表示） */}
  {websiteUrl && <NewTabMark />}
  <div class="flex flex-col items-center text-center">
    <div class="w-14 h-14 mb-3">
      {imageUrl ? (
        <img src={imageUrl} alt="" class="w-full h-full object-contain rounded-full bg-white p-1.5">
      ) : (
        <div class="w-full h-full bg-blue-950/90 rounded-full flex items-center justify-center">
          <span class="text-xl font-bold">{name.charAt(0)}</span>
        </div>
      )}
    </div>
    <h3 class="text-lg font-bold mb-2">{name}</h3>
    <p class="text-sm text-white/70">
      {roles.map((role, index) => (
        <>
          {role}{index < roles.length - 1 && <br />}
        </>
      ))}
    </p>
  </div>
</Tag>
